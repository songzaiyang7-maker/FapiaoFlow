# 复制此文件为 .env，填入你自己的 DeepSeek API key
# 申请地址：https://platform.deepseek.com/

DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 分类器后端：rule | llm | hybrid（默认 hybrid：规则优先，低置信调 LLM）
CLASSIFIER_BACKEND=hybrid

# 规则置信度低于此值时调用 LLM（0.0-1.0）
LLM_FALLBACK_THRESHOLD=0.7

# OCR 识别扫描件（纸质发票拍照件/扫描 PDF）
# true=开启（默认），false=关闭（扫描件直接标记失败，省内存）
OCR_ENABLED=true

# DeepSeek 模型名
# - deepseek-v4-flash：V4 Flash，快、便宜（推荐用于发票分类）
# - deepseek-v4-pro：V4 Pro，准确率更高但慢、贵
DEEPSEEK_MODEL=deepseek-v4-flash
